# ==============================================================================
# RoadGuard AI — Production Environment Variables Reference
# ==============================================================================
# NOTE: Do NOT commit actual secrets or production values to Git.
#
# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# The public HTTPS URL of your deployed Spring Boot backend.
# Example: https://roadguard-api.onrender.com
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Set in Render / Railway / Cloud Run Dashboard)
# ------------------------------------------------------------------------------
# Server port dynamically provided by hosting platform (default: 8080)
PORT=8080

# Production Database (PostgreSQL recommended; do NOT use in-memory H2 in production)
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/<db-name>
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Flyway Database Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# CORS Allowed Origins (Comma-separated list of allowed origins)
# Example: http://localhost:5173,https://roadguard-ai.vercel.app,https://*.vercel.app
ROADGUARD_CORS_ALLOWED_ORIGINS=https://roadguard-ai.vercel.app,https://*.vercel.app

# Evidence Storage Directory (Must be mapped to a persistent volume or mount path)
ROADGUARD_UPLOAD_DIR=/app/uploads/evidence

# ONNX Model Path (Path inside the container/filesystem)
ROADGUARD_MODEL_PATH=models/road_damage_yolo.onnx

# Security: Keep H2 Console disabled in production
H2_CONSOLE_ENABLED=false
