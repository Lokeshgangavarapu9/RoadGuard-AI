# RoadGuard AI - Local Government Portal Automation Worker Configuration
# Copy this file to .env and customize as needed.

# Backend API URL (Default: local Spring Boot backend)
# For production Render backend: https://roadguard-ai-tael.onrender.com
BACKEND_URL=http://localhost:8080

# Unique Worker Identifier (auto-generated if left blank)
WORKER_ID=

# Playwright Browser Mode: false = headed (interactive browser window for citizen OTP/CAPTCHA)
# Set to true only in headless testing environments
HEADLESS=false

# Worker Authentication Secret (must match roadguard.automation.worker-secret in backend if configured)
WORKER_SECRET=roadguard-worker-local-dev-token

# Polling Interval in milliseconds (default: 3000ms)
POLL_INTERVAL_MS=3000

# Heartbeat Interval in milliseconds (default: 5000ms)
HEARTBEAT_INTERVAL_MS=5000

# Maximum wait time for Citizen OTP entry in seconds (default: 300s = 5 minutes)
CITIZEN_WAIT_TIMEOUT_SECONDS=300

# Directory for storing audit screenshots
SCREENSHOT_DIR=./screenshots
